Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 10
    - Class: rviz/RobotModel
      Name: Realhand L30
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 0.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0.2
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800